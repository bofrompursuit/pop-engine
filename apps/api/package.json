{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "migrate": "node-pg-migrate -j ts -m migrations",
    "start": "pnpm migrate up && tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pop-engine/engine": "workspace:*",
    "express": "^4.21.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
