# apps/api — copy to .env for local dev. Never commit real secrets.
# Demo policy (AD-12): synthetic data only; no real PII, documents, or contact info.

PORT=3001
WEB_ORIGIN=http://localhost:3000

# Postgres (Supabase) — system of record
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Object storage (Supabase Storage via its S3-compatible endpoint) — F-202 uploads.
# Standard SigV4 presigned URLs, so the storage code stays vendor-neutral.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=pop-engine-documents

# Email (Resend) — live in the demo
RESEND_API_KEY=
SMTP_FROM="PopEngine <noreply@example.com>"

# SMS (Twilio) — A2P 10DLC registration pending; labeled simulation until approved (T-1)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rules file the engine validates at boot (AD-2)
RULES_FILE=../../rules/nyc-rules.v2.3.json
